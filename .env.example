# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/grading_db
TEST_DATABASE_URL=sqlite:///./test.db

# Authentication
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Submission storage
SUBMISSION_STORAGE_PATH=./submission_data
SUBMISSION_MAX_BYTES=262144

# Sandbox execution
GRADING_SANDBOX_IMAGE=grading-sandbox:latest
GRADING_TIMEOUT_SECONDS=10
GRADING_MEMORY=256m
GRADING_CPUS=1.0
GRADING_PIDS_LIMIT=64

# AI Integration
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gemini-2.5-flash
AI_DETECTOR_MODEL_PATH=./experiments/codebert/checkpoints/best_model

# JPlag 6.2.0 (optional; requires a local JAR and Java 21+)
JPLAG_JAR_PATH=./tools/jplag-6.2.0.jar

# Security & CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
ENABLE_DEMO_ENDPOINTS=false # Set to true only in development/demo environments
