DATABASE_URL=postgresql://grading_user:replace-me@localhost:5432/grading_db
GRADING_MAX_TEST_CASES=100
SECRET_KEY=generate-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000
DEBUG=false
SUBMISSION_STORAGE_PATH=/data/submissions
SUBMISSION_MAX_BYTES=262144
GRADING_POLL_SECONDS=1
GRADING_TIMEOUT_SECONDS=10
GRADING_MEMORY=128m
GRADING_CPUS=0.5
GRADING_PIDS_LIMIT=64
GRADING_OUTPUT_MAX_BYTES=32768
GRADING_SANDBOX_IMAGE=ai-grading-sandbox:latest
